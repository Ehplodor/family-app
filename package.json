{
  "name": "family-app",
  "version": "0.1.0",
  "private": true,
  "description": "Application familiale local-first (PWA) : données sur les appareils, partage chiffré de bout en bout, rappels.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build && vite build -c vite.sw.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "relay:dev": "npm --prefix relay run dev",
    "relay:test": "npm --prefix relay run test:ci"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.500.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
