{
  "name": "family-app",
  "version": "0.1.0",
  "private": true,
  "description": "Application familiale auto-hébergée : listes, calendrier, anniversaires, messages, repas, tâches, galerie…",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --run dev:server & vite",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "build": "tsc --noEmit -p . && vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.500.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
